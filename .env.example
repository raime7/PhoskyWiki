# PostgreSQL（docker compose up 后即可用）
DATABASE_URL=postgres://phosky:phosky@localhost:5432/phoskywiki

# Meilisearch（派生搜索索引，ADR-0002）
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key

# better-auth（认证，T05）——生产环境必须换成强随机值（openssl rand -hex 32）
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789abcdef0123456789
BETTER_AUTH_URL=http://localhost:3000
INVITATION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600

# 种子管理员（pnpm db:seed 灌入；密码留空则每次随机生成并打印到控制台）
SEED_ADMIN_EMAIL=admin@phoskywiki.local
SEED_ADMIN_PASSWORD=

# R2 私有桶（T15）；CORS 与暂存清理规则见 docs/content-production.md
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 可选：真实 R2 契约测试专用桶，未配置则明确跳过
R2_CONTRACT_ENDPOINT=
R2_CONTRACT_BUCKET=
R2_CONTRACT_ACCESS_KEY_ID=
R2_CONTRACT_SECRET_ACCESS_KEY=
