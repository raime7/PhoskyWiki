{
    admin off
    auto_https disable_redirects
    persist_config off
    servers {
        trusted_proxies static {$CLOUDFLARE_CIDRS}
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
        strict_sni_host on
    }
}

(cloudflare_only) {
    @outside not remote_ip {$CLOUDFLARE_CIDRS}
    respond @outside "Forbidden" 403
}

(dns_certificate) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
        resolvers 1.1.1.1 1.0.0.1
    }
}

# Published only on host loopback; never expose a second application gateway.
:8080 {
    @health {
        method GET HEAD
        path /healthz
    }
    handle @health {
        reverse_proxy app:3000
    }
    respond 404
}

http://phoskywiki.org, http://www.phoskywiki.org {
    route {
        import cloudflare_only
        redir https://phoskywiki.org{uri} 308
    }
}

www.phoskywiki.org {
    import dns_certificate
    route {
        import cloudflare_only
        redir https://phoskywiki.org{uri} 308
    }
}

phoskywiki.org {
    import dns_certificate
    import cloudflare_only
    reverse_proxy app:3000 {
        # Discard client-supplied chains. Better Auth receives one verified IP.
        header_up X-Forwarded-For {client_ip}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-Proto https
        header_up -Forwarded
        header_up -CF-Connecting-IP
    }
}
