{
    admin off
}

:8080 {
    reverse_proxy app:3000
}

phoskywiki.org {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    # Keep registration closed until the invitation workflow is deployed.
    @registration path /register /api/auth/sign-up/*
    respond @registration "Registration is not open." 403
    reverse_proxy app:3000
}
