[Unit]
Description=PhoskyWiki encrypted recovery point
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/phoskywiki
EnvironmentFile=/etc/phoskywiki/deployment.env
ExecStart=/usr/bin/flock -n /run/lock/phoskywiki-backup.lock /usr/bin/python3 /opt/phoskywiki/deploy/phoskywiki-backup-run.py
TimeoutStartSec=1h
ExecStopPost=-/usr/bin/docker rm -f phoskywiki-scheduled-backup
UMask=0077
