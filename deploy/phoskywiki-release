#!/bin/sh
# Install root:root 0755 as /usr/local/sbin/phoskywiki-release.
# Only this fixed command is allowed in the deploy account's sudoers entry.
set -eu
export PATH=/usr/local/bin:/usr/bin:/bin
export GH_HOST=github.com
export GH_CONFIG_DIR=/etc/phoskywiki/github
export GH_TOKEN="$(cat /etc/phoskywiki/release-github-token)"
unset GITHUB_TOKEN NODE_OPTIONS NODE_PATH
exec /usr/bin/node /opt/phoskywiki/scripts/release.mjs /etc/phoskywiki/release.json
