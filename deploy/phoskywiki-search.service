[Unit]
Description=PhoskyWiki full search reconciliation
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/phoskywiki
EnvironmentFile=/etc/phoskywiki/deployment.env
# Same lock as backup: avoid overlapping their peak resource usage.
ExecStart=/usr/bin/flock -n /run/lock/phoskywiki-backup.lock /usr/bin/docker compose -f compose.production.yml -f compose.maintenance.yml --profile ops run --name phoskywiki-search-reconcile --rm -T --interactive=false --no-deps ops reindex --target postgres:5432/phoskywiki/phosky --search http://meilisearch:7700/pages
TimeoutStartSec=20min
ExecStopPost=-/usr/bin/docker rm -f phoskywiki-search-reconcile
UMask=0077
StandardOutput=journal
StandardError=journal
